{
  "functions": {
    "api/page.js": { "includeFiles": "app.html" },
    "api/logo.js": { "includeFiles": "app.html" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/page" },
    { "source": "/index.html", "destination": "/api/page" },
    { "source": "/:semester/:jenis/:mapel/:kelas", "destination": "/api/page" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]},
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
    ]},
    { "source": "/manifest.json", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ]}
  ]
}
